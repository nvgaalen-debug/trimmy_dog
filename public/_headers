# Trimmy · beveiligingsregels voor Netlify
# Scripts alleen uit eigen bestanden, geen frames, gegevens alleen naar de eigen site
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/portaal*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/app.css
  Cache-Control: public, max-age=0, must-revalidate

/welkom*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
/beheer*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
